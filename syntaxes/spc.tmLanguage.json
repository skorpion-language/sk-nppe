{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Skorpion Project Configuration",
  "scopeName": "source.spc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#parameter" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.spc",
          "match": "^\\s*#!.*$"
        }
      ]
    },

    "parameter": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\[)",
          "captures": {
            "1": { "name": "variable.other.parameter.spc" },
            "2": { "name": "punctuation.section.brackets.begin.spc" }
          },
          "push": [
            { "include": "#value" },
            { "include": "#close-bracket" }
          ]
        }
      ]
    },

    "close-bracket": {
      "patterns": [
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.spc",
          "pop": true
        }
      ]
    },

    "value": {
      "patterns": [
        { "include": "#array" },
        { "include": "#string" }
      ]
    },

    "array": {
      "patterns": [
        {
          "name": "meta.array.spc",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.array.begin.spc" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.array.end.spc" }
          },
          "patterns": [
            { "include": "#string" },
            { "include": "#reference" },
            {
              "name": "punctuation.separator.array.spc",
              "match": ","
            }
          ]
        }
      ]
    },

    "reference": {
      "patterns": [
        {
          "match": "(\\&)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.reference.spc" },
            "2": { "name": "variable.other.reference.spc" }
          }
        }
      ]
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.spc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.spc",
              "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
            }
          ]
        }
      ]
    }
  }
}